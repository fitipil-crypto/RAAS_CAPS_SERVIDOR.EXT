# ── RAAS-CAPS — edição servidor ──
# Copie para .env e preencha. NUNCA versione o .env: ele tem as senhas.
#   cp .env.prod.example .env

# Domínio pelo qual o sistema será acessado (sem https://).
# Precisa apontar para o IP deste servidor ANTES de pedir o certificado.
DOMINIO=raas.suacidade.gov.br

# E-mail para os avisos de vencimento do certificado (opcional).
EMAIL_CERTIFICADO=

# ── Banco de dados (PostgreSQL) ──
POSTGRES_DB=raas_caps
POSTGRES_USER=raas
# Gere com:  openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Chave das sessões ──
# Gere com:  openssl rand -base64 48
# Trocar esta chave derruba as sessões abertas (todo mundo faz login de novo).
SECRET_KEY=

# ── Primeiro acesso ──
# Senha inicial do usuário "admin". A troca é obrigatória no primeiro login.
# Deixe vazio para usar "admin" — aceitável só se você entrar e trocar na hora.
ADMIN_INITIAL_PASSWORD=

# ── Sessão (LGPD) ──
# Minutos sem atividade até encerrar a sessão e duração máxima dela.
SESSAO_INATIVIDADE_MIN=30
SESSAO_MAX_HORAS=12

# ── Backup ──
# Quantos dias de backup do PostgreSQL guardar em ./backups.
BACKUP_MANTER_DIAS=30

# ── Avançado ──
# O DATABASE_URL é montado pelo docker-compose a partir das variáveis acima.
# Para apontar para um PostgreSQL de fora do compose (banco gerenciado), defina:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/raas_caps?sslmode=require
#
# BACKUP_AUTO_LOCAL=true religa o agendador de backup em pasta de rede do
# Windows. Só serve para quem roda esta cópia em rede local, não no servidor.
