# Proxy reverso do RAAS-CAPS com HTTPS.
# ${DOMINIO} é substituído pela imagem do nginx ao iniciar (templates/).

# HTTP: só serve o desafio do Let's Encrypt e manda o resto para o HTTPS.
# Dado de saúde não deve trafegar em claro, nem por um redirecionamento perdido.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMINIO};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMINIO};

    ssl_certificate     /etc/letsencrypt/live/${DOMINIO}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMINIO}/privkey.pem;

    # Só TLS 1.2 e 1.3: as versões anteriores têm ataques conhecidos.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS: o navegador passa a só aceitar HTTPS neste domínio. Enquanto vale,
    # não há como voltar para HTTP aqui — confirme o certificado antes.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Os demais cabeçalhos de segurança (CSP, X-Frame-Options, no-store) são
    # postos pela própria aplicação, no SegurancaMiddleware. Repeti-los aqui
    # criaria dois lugares para manter a mesma política.

    # Importação de RAAS e planilhas; o padrão do nginx (1 MB) rejeitaria.
    client_max_body_size 32m;

    # Sem o nome do servidor na página de erro e nos cabeçalhos.
    server_tokens off;

    access_log /var/log/nginx/raas_access.log;
    error_log  /var/log/nginx/raas_error.log warn;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://web:8000;
        proxy_http_version 1.1;

        # A aplicação confia nestes cabeçalhos (TRUST_PROXY=true): é por eles
        # que ela sabe o host real e que o acesso veio por HTTPS. Sem o
        # X-Forwarded-Proto, a checagem de Origin recusaria os formulários.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # Relatórios grandes e exportação de competência demoram mais que o
        # padrão de 60 s.
        proxy_connect_timeout 15s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;

        proxy_buffering off;
    }

    # Os estáticos já vão com Cache-Control: no-cache e ETag pela aplicação
    # (revalidação em 304), então não há o que ajustar aqui.
    location /static/ {
        proxy_pass http://web:8000/static/;
        proxy_set_header Host $host;
    }

    # O healthcheck não precisa aparecer no log de acesso.
    location = /saude {
        proxy_pass http://web:8000/saude;
        proxy_set_header Host $host;
        access_log off;
    }
}
