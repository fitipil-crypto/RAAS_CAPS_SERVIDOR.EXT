DATABASE_URL=sqlite:///./raas_caps.db

# Chave das sessões. Deixe vazio para gerar automaticamente (arquivo secret.key)
# ou defina um valor longo e aleatório. NUNCA use um valor de exemplo.
SECRET_KEY=

DEBUG=false

# Senha do usuário "admin" na primeira instalação (trocada obrigatoriamente no 1º acesso).
# Se vazio, usa "admin".
ADMIN_INITIAL_PASSWORD=

# ── Uso em rede (LGPD) ──
# Acessando por HTTPS (ngrok, Cloudflare, proxy reverso): true
COOKIE_SECURE=false
# Atrás de proxy/túnel confiável (usa X-Forwarded-For/Host/Proto): true
TRUST_PROXY=false
# Hosts extras aceitos em Origin/Referer (separados por vírgula), se o proxy reescrever o Host
ORIGENS_PERMITIDAS=
# Minutos sem atividade até encerrar a sessão e duração máxima da sessão (horas)
SESSAO_INATIVIDADE_MIN=30
SESSAO_MAX_HORAS=12

CLOUDFLARE_TOKEN=
NGROK_AUTHTOKEN=
